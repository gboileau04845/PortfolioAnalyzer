# --- Fabric Data Agent ---
# URL OpenAI-compatible du data agent publié (sans slash final).
DATA_AGENT_URL=https://api.fabric.microsoft.com/v1/workspaces/93290b87-7031-4264-92c6-a4fad953dace/dataagents/950ee928-422c-4c64-8262-5cfe2012aabf/aiassistant/openai

# Version d'API passée en query string (?api-version=...). Validée par MS.
DATA_AGENT_API_VERSION=2024-05-01-preview

# Scope du token AAD. L'endpoint est sous api.fabric.microsoft.com.
# Si tu obtiens un 401/403, essaie : https://analysis.windows.net/powerbi/api/.default
FABRIC_SCOPE=https://api.fabric.microsoft.com/.default

# --- Authentification : identité utilisateur (connexion navigateur) ---
# Au lancement de la 1re question, un navigateur s'ouvre pour ta connexion
# Entra ID. Le data agent tourne ensuite avec TES droits.
#
# AZURE_TENANT_ID : recommandé (ton tenant). Évite de tomber sur le mauvais.
AZURE_TENANT_ID=<ton-tenant-id>
#
# AZURE_CLIENT_ID : OPTIONNEL. App registration (client public, redirect URI
# http://localhost) avec permissions déléguées Fabric/Power BI. Si laissé vide,
# azure-identity utilise son client public par défaut. À renseigner si tu as une
# erreur AADSTS sur le client/redirect.
# AZURE_CLIENT_ID=<client-id-app-registration>

# Délai max d'attente d'une réponse du data agent (secondes).
AGENT_TIMEOUT=120
